# Local Postgres (dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/factorydepo
PORT=9091
APP_SECRET=change-me-in-production
SITE_URL=http://localhost:8080
# Comma-separated extra origins allowed for authenticated requests (e.g. a
# marketing landing served from a different host than SITE_URL)
# EXTRA_ORIGINS=https://a.example.com,https://b.example.com
# Web app — leave unset for same-origin API (prod); set for cross-origin dev
# VITE_API_URL=http://localhost:9091/api
