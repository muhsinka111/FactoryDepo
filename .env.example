# Local Postgres (dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/factorydepo
PORT=9091
APP_SECRET=change-me-in-production
SITE_URL=http://localhost:8080
# Comma-separated extra origins allowed for authenticated requests (e.g. a
# marketing landing served from a different host than SITE_URL)
# EXTRA_ORIGINS=https://a.example.com,https://b.example.com
# Web app — leave unset for same-origin API (prod); set for cross-origin dev
# VITE_API_URL=http://localhost:9091/api

# Owner admin — created/updated on every API boot when both are set.
# In production the seeded demo admin (demo@factorydepo.com / factorydepo) is
# NOT created, so this is how the owner account gets made. Password must be
# 12+ characters or the server logs a warning and skips it.
# ADMIN_EMAIL=muhsinka@hotmail.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Muhsin Kayikci

# Transactional email (Resend). Unset → email is queued in email_outbox and not
# sent, so nothing is lost while the provider is not yet configured.
# RESEND_API_KEY=
# EMAIL_FROM=FactoryDepo <no-reply@factorydepo.com>
