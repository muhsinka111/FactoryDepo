{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile=false && pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/web run build"
  },
  "deploy": {
    "startCommand": "NODE_ENV=production pnpm --filter @workspace/api-server start",
    "healthcheckPath": "/api/healthz",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
