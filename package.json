{
  "name": "factorydepo-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "dev:web": "pnpm --filter @workspace/web run dev",
    "dev:api": "PORT=9091 pnpm --filter @workspace/api-server run dev",
    "seed": "DATABASE_URL=\"postgres://postgres:postgres@localhost:5432/factorydepo\" pnpm --filter @workspace/db exec tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.62.2",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
